# PostgreSQL connection string (Render PostgreSQL, Neon, Supabase, etc.)
# When omitted locally, the app uses the embedded PGlite database in ./.data
DATABASE_URL=

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Optional: force SSL on/off for PostgreSQL. Auto-detected by default.
# DATABASE_SSL=false

PORT=3000
